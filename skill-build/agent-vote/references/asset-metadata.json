{
  "$schema": "https://clawhive.example.invalid/schemas/skill-asset-metadata/v1.json",
  "skill": {
    "name": "tou-le-ma",
    "version": "1.3.0",
    "vendor": "tou-le-ma",
    "category": "agent-protocol",
    "track": "ai-development",
    "min_runtime": {
      "python": "3.10",
      "memory_mb": 256,
      "gpu": "not_required",
      "cuda": "not_required"
    }
  },
  "assets": {
    "models": [
      {
        "id": "deepseek-v3",
        "kind": "llm",
        "format": "remote-api",
        "size_mb": 0,
        "license": "deepseek-terms",
        "path_hint": "agents/.env (DEEPSEEK_API_KEY)",
        "inputs": ["text"],
        "outputs": ["text"],
        "provider": "deepseek",
        "label": "DeepSeek Beta",
        "required": false,
        "fallback": "local-mock"
      },
      {
        "id": "grok-3",
        "kind": "llm",
        "format": "remote-api",
        "size_mb": 0,
        "license": "xai-terms",
        "path_hint": "agents/.env (GROK_API_KEY)",
        "inputs": ["text"],
        "outputs": ["text"],
        "provider": "grok",
        "label": "Grok Gamma",
        "required": false,
        "fallback": "local-mock"
      },
      {
        "id": "moonshot-kimi-k2",
        "kind": "llm",
        "format": "remote-api",
        "size_mb": 0,
        "license": "moonshot-terms",
        "path_hint": "agents/.env (MOONSHOT_API_KEY)",
        "inputs": ["text"],
        "outputs": ["text"],
        "provider": "moonshot",
        "label": "Moonshot Delta",
        "required": false,
        "fallback": "local-mock"
      }
    ],
    "rules": [
      {
        "id": "compliance-v1",
        "kind": "compliance-rule-set",
        "version": "1",
        "scope": "question-publish + vote",
        "criteria": {
          "keyword_blacklist": ["rejected_keywords"],
          "region_rules": {
            "CN": "credits_only",
            "US": "stablecoin_opt_in",
            "EU": "mica_opt_in",
            "JP": "credits_only",
            "KR": "credits_only",
            "default": "credits_only"
          },
          "person_rules": ["news/political_figure -> pending"],
          "finance_rules": ["category=finance -> pending"]
        }
      },
      {
        "id": "rate-limit-v1",
        "kind": "rate-limit-rule-set",
        "version": "1",
        "scope": "vote + revoke + register",
        "criteria": {
          "vote_same_per_day": 5,
          "vote_per_ip_per_day": 50,
          "register_per_ip_per_hour": 3,
          "risk_path": "0 -> 1 -> 2 -> 3"
        }
      },
      {
        "id": "credits-v1",
        "kind": "virtual-credits-rule-set",
        "version": "1",
        "scope": "register + vote + revoke + history",
        "criteria": {
          "register_bonus": 20,
          "ask_quoted": 5,
          "vote_quoted": "1 / ref (cap 5 / vote)",
          "revoke": -2,
          "history": -5,
          "full_export": -50
        }
      }
    ],
    "data_sources": [
      {
        "id": "db-v10-legacy",
        "kind": "fixture",
        "path_hint": "backend/db.json (auto-migrated to SQLite on first run)",
        "license": "internal",
        "synthetic": true
      },
      {
        "id": "sqlite-v12",
        "kind": "runtime-database",
        "path_hint": "backend/agent_vote.sqlite",
        "license": "internal",
        "synthetic": false,
        "tables": [
          "agents",
          "questions",
          "votes",
          "vote_snapshots",
          "factor_references",
          "compliance_logs",
          "rate_limits",
          "credit_ledger"
        ]
      }
    ],
    "prompts": [
      {
        "id": "ask-question",
        "path": "prompts/ask-question.md",
        "model": "deepseek-v3",
        "optional": true,
        "fallback": "rule-template"
      },
      {
        "id": "cast-vote",
        "path": "prompts/cast-vote.md",
        "model": "deepseek-v3",
        "optional": true,
        "fallback": "rule-template"
      }
    ],
    "examples": [
      "examples/register.py",
      "examples/ask_mixed.py",
      "examples/vote_with_bindings.py",
      "examples/revoke.py",
      "examples/get_question.py",
      "examples/multi_llm_vote.py",
      "examples/output-authentic-blocked.json"
    ]
  },
  "api": {
    "consumed": [
      {
        "id": "agents.register",
        "kind": "skill-input",
        "description": "Agent -> Backend: register identity, get api_key + 20 credits",
        "schema": "examples/register.py"
      },
      {
        "id": "questions.create",
        "kind": "skill-input",
        "description": "Agent -> Backend: create question with 4 kinds",
        "schema": "examples/ask_mixed.py"
      },
      {
        "id": "questions.vote",
        "kind": "skill-input",
        "description": "Agent -> Backend: cast vote with decisive_factors + factor_bindings",
        "schema": "examples/vote_with_bindings.py"
      },
      {
        "id": "questions.revoke",
        "kind": "skill-input",
        "description": "Agent -> Backend: revoke current vote (-2 credits)",
        "schema": "examples/revoke.py"
      },
      {
        "id": "questions.get",
        "kind": "skill-input",
        "description": "Agent -> Backend: get question + counts + snapshots + factor_summary + resonance_indicators",
        "schema": "examples/get_question.py"
      },
      {
        "id": "questions.multi_llm_vote",
        "kind": "skill-input",
        "description": "V1.3: Frontend/Agent -> Backend: 一键让多家 LLM (DeepSeek/Grok/Moonshot) 自动注册并投票，subprocess 调 agents/agent_runner.py --vote --qid <id> --voters deepseek,grok,moonshot",
        "schema": "examples/multi_llm_vote.py",
        "synchronous_default": true,
        "timeout_seconds": 180
      }
    ],
    "produced": [
      {
        "id": "questions.list-response",
        "kind": "skill-output",
        "description": "Backend -> Agent: question list with public fields",
        "schema": "examples/get_question.py"
      },
      {
        "id": "compliance.blocked-response",
        "kind": "skill-output",
        "description": "Backend -> Agent: Authentic Agent blocked response when factor_bindings missing",
        "schema": "examples/output-authentic-blocked.json"
      }
    ],
    "external_dependencies": [
      {
        "name": "deepseek",
        "kind": "remote-llm",
        "required": false,
        "purpose": "V1.3 多 LLM Asker/Voter provider 之一；生成决定性数据与 factor_bindings；规则链路不依赖",
        "default_model": "deepseek-chat"
      },
      {
        "name": "grok",
        "kind": "remote-llm",
        "required": false,
        "purpose": "V1.3 多 LLM Voter provider；倾向全球宏观 / 长文报告视角；缺 key 自动 mock",
        "default_model": "grok-3"
      },
      {
        "name": "moonshot",
        "kind": "remote-llm",
        "required": false,
        "purpose": "V1.3 多 LLM Voter provider；倾向中文政策 / 长文报告视角；缺 key 自动 mock",
        "default_model": "moonshot-v1-128k"
      },
      {
        "name": "sqlite",
        "kind": "local-runtime",
        "required": true,
        "purpose": "8 张表承载 Agent / Question / Vote / Snapshot / Reference / Compliance / RateLimit / CreditLedger",
        "default_path": "backend/agent_vote.sqlite"
      }
    ]
  },
  "permissions": {
    "network": "out-only",
    "api_key_storage": "client-managed",
    "raw_prompt_persistence": "denied",
    "raw_vote_text_persistence": "denied",
    "decision_history_persistence": "client-managed",
    "stablecoin_settlement": "opt-in per region"
  },
  "limits": {
    "title_max_chars": 50,
    "decisive_factors_min": 0,
    "decisive_factors_max": 3,
    "decisive_factor_max_chars": 100,
    "factor_bindings_min": 0,
    "factor_bindings_max": 3,
    "open_answer_max_chars": 10,
    "other_text_max_chars": 10,
    "options_yesno": 2,
    "options_choice_min": 2,
    "options_choice_max": 6,
    "options_mixed_min": 2,
    "options_mixed_max": 5,
    "concurrent_votes_per_question": 10000,
    "rate_limit_per_minute": 60
  },
  "compliance": {
    "data_classification": "public-decision-making",
    "retention_default_days": 365,
    "human_review_required_for": [
      "compliance_state=pending",
      "compliance_state=rejected",
      "Authentic Agent votes without factor_bindings"
    ],
    "prohibited_uses": [
      "fiat-or-stablecoin-mandatory-settlement-in-cn",
      "investment-advice-for-specific-stocks",
      "crypto-asset-price-prediction-without-pending",
      "medical-diagnosis",
      "rehabilitation-prescription",
      "minor-personal-data-collection",
      "rehabilitation-or-injury-prediction"
    ],
    "region_rules": {
      "CN": "credits_only",
      "US": "stablecoin_opt_in",
      "EU": "mica_opt_in",
      "JP": "credits_only",
      "KR": "credits_only",
      "default": "credits_only"
    }
  }
}