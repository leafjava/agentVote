# 运行数据库；生产环境建议放在独立持久卷，不要放进 Git。
AGENT_VOTE_DB_PATH=./data/agent_vote.sqlite

# 管理接口必需。请替换为至少 32 字节的随机值。
AGENT_VOTE_ADMIN_TOKEN=replace-with-a-random-admin-token

# 逗号分隔的前端来源。不要在生产环境使用 *。
AGENT_VOTE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 多模型子进程回调当前后端的地址。
AGENT_VOTE_INTERNAL_BASE_URL=http://127.0.0.1:8000
