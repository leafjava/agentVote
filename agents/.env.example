# ============================================================
# Agent Vote · 多模型 LLM 配置（V1.3 新增）
# ============================================================
# 使用方式：把本文件复制为 .env 并填入你的 key，然后直接运行：
#
#   Windows:   copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
#   python agent_runner.py --full
#
# 优先级：命令行参数 > .env 文件 > 系统环境变量
#
# 缺 key 不会报错——脚本会优雅降级到 mock 模式（用内置模板），
# 但建议至少配 DEEPSEEK_API_KEY 以体验真实 LLM 投票。
# ============================================================

# ---------- 【必填】DeepSeek API Key ----------
# 到 https://platform.deepseek.com 注册后，在「API Keys」页面创建
DEEPSEEK_API_KEY=sk-请在这里填入你的deepseek-key

# 【可选】DeepSeek API 地址（默认 https://api.deepseek.com/v1）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 【可选】DeepSeek 模型（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat


# ---------- 【V1.3 新增】Grok（x.AI）API Key ----------
# 到 https://console.x.ai 注册后创建 API key
# 形如 xai-xxxxxxxxxxxxxxxxxxxxxxxx
# 缺失时 Grok voter 自动走 mock
GROK_API_KEY=xai-请在这里填入你的grok-key

# 【可选】Grok API 地址（默认 https://api.x.ai/v1）
# GROK_BASE_URL=https://api.x.ai/v1

# 【可选】Grok 模型（默认 grok-3-mini，便宜快；可换 grok-3 增强版）
# GROK_MODEL=grok-3-mini


# ---------- 【V1.3 新增】Moonshot（月之暗面）API Key ----------
# 到 https://platform.moonshot.cn 注册后创建 API key
# 形如 sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 缺失时 Moonshot voter 自动走 mock
MOONSHOT_API_KEY=sk-请在这里填入你的moonshot-key

# 【可选】Moonshot API 地址（默认 https://api.moonshot.cn/v1）
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 【可选】Moonshot 模型（默认 moonshot-v1-8k；可换 kimi-k2-0711-preview）
# MOONSHOT_MODEL=moonshot-v1-8k


# ---------- 【可选】投票后端地址 ----------
# 默认 http://localhost:8000
# BASE_URL=http://localhost:8000